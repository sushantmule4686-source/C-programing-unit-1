#include <stdio.h>

unsigned long long factorial(int n)
{
    int i;
    unsigned long long fact = 1;
    for (i = 1; i <= n; i++)
    {
        fact = fact * i;
    }
    return fact;
}

int main()
{
 int num;
 long int result;
 printf("Enter a number: ");
 scanf("%d", &num);
 result = factorial(num);
 printf("Factorial of %d = %ld\n", num, result);
 return 0;
}
